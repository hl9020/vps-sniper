# Hetzner Cloud API token of the project where servers get ordered.
# Read is enough for notify jobs, order jobs need Read & Write.
HCLOUD_TOKEN=

# Optional: Read token of a separate, empty project used only for checking availability.
# The rate limit (3600 requests/hour) is per project. Leave empty to use HCLOUD_TOKEN.
HCLOUD_POLL_TOKEN=

# Login for the web UI (HTTP Basic Auth). Put the app behind HTTPS if it is reachable from outside.
ADMIN_USER=admin
ADMIN_PASSWORD=

# SMTP account for alert mails. Port 465 uses TLS, 587 uses STARTTLS.
# Wrap the password in single quotes if it contains # or spaces.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VPS-Sniper <alerts@example.com>
# Recipients, comma separated
SMTP_TO=

PORT=8080
DATA_DIR=./data
